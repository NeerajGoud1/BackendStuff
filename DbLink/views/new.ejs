<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New User</title>
</head>
<body>
    <h2>You are about to add new user in DataBase</h2>
    <form method="post" action="/user/new">
        <input type="text" placeholder="Enter id" name="id"><br><br>
        <input type="text" placeholder="Enter Username" name="username"><br><br>
        <textarea name="email" placeholder="Enter email"></textarea><br><br>
        <input type="password" placeholder="create Password" name="password"><br><br>
        <button>Add</button>
    </form>
</body>
</html>