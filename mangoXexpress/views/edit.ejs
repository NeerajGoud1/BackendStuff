<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit</title>
  </head>
  <body>
    <p>
      Edit your Message <b><%= c.from %></b> which is sent to <b><%= c.to %></b>
    </p>
    <form method="post" action="/chats/<%=c.id %>">
      <textarea rows="6" cols="50" name="msg"><%=c.msg%></textarea> <br /><br />
      <button>Submit</button>
    </form>
  </body>
</html>
