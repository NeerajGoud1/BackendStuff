<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WhatsApp</title>
    <link rel="stylesheet" href="/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <h1>All Chats</h1>
    <% if(success && success.length) { %>
    <div
      class="alert alert-success alert-dismissible offset-3 col-6"
      role="alert"
    >
      <%= success %>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
      ></button>
    </div>
    <% } %> <% if(failure && success.failure) { %>
    <div
      class="alert alert-success alert-dismissible offset-3 col-6"
      role="alert"
    >
      <%= failure %>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
      ></button>
    </div>
    <% } %> <% for(let chat of chats) { %>

    <div class="chat">
      <p><b> From <%= chat.from %></b></p>

      <div class="msg"><p><%= chat.msg %></p></div>

      <p><b> Received By <%= chat.to %></b></p>
      <hr />
      <p><%= chat.checked_at.toString().split(" ")[4] %></p>
      <p><%= chat.checked_at.toString().split(" ").slice(0,4).join(" ") %></p>
      <form method="GET" action="/chats/<%=chat._id %>/edit">
        <button>Edit</button>
      </form>
      <form method="post" action="/chats/<%= chat._id %>?_method=DELETE">
        <button>Delete</button>
      </form>
    </div>

    <% } %>

    <form action="/chats/new">
      <button>Add Message</button>
    </form>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
